[submodule "omz-custom/plugins/autoupdate"]
	path = omz-custom/plugins/autoupdate
	url = https://github.com/TamCore/autoupdate-oh-my-zsh-plugins
[submodule "omz-custom/plugins/you-should-use"]
	path = omz-custom/plugins/you-should-use
	url = https://github.com/MichaelAquilina/zsh-you-should-use.git
[submodule "omz-custom/plugins/zsh-autosuggestions"]
	path = omz-custom/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "omz-custom/plugins/zsh-bat"]
	path = omz-custom/plugins/zsh-bat
	url = https://github.com/fdellwing/zsh-bat.git
[submodule "omz-custom/plugins/zsh-completions"]
	path = omz-custom/plugins/zsh-completions
	url = https://github.com/zsh-users/zsh-completions.git
[submodule "omz-custom/plugins/zsh-syntax-highlighting"]
	path = omz-custom/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
